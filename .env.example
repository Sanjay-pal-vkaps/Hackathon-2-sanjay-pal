# Daily summary schedule (24-hour local wall-clock time format HH:mm, e.g., 09:00)
DAILY_SUMMARY_TIME=09:00
APP_TIMEZONE=Asia/Kolkata
CRON_SECRET=replace_me_with_secure_random_cron_secret

# Telegram bot configuration (server-side only; never expose to frontend)
TELEGRAM_BOT_TOKEN=replace_me_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_me_with_authorized_chat_id
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_WEBHOOK_SECRET=replace_me_with_telegram_webhook_secret_token

# Google Workspace (Gmail & Calendar OAuth2 - Read-Only)
GOOGLE_CLIENT_ID=replace_me_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_me_with_google_client_secret
GOOGLE_REFRESH_TOKEN=replace_me_with_google_refresh_token
GOOGLE_ACCESS_TOKEN=replace_me_if_using_static_or_short_lived_token
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Slack Configuration (Read-Only)
SLACK_BOT_TOKEN=xoxb-replace_me
SLACK_SIGNING_SECRET=replace_me_with_slack_signing_secret
SLACK_AUTHORIZED_CHANNELS=C12345678,C87654321

# Trello Configuration (Explicit Approval Write Gate)
TRELLO_API_KEY=replace_me_with_trello_api_key
TRELLO_API_TOKEN=replace_me_with_trello_api_token
TRELLO_DEFAULT_BOARD_ID=replace_me_with_default_board_id
TRELLO_DEFAULT_LIST_ID=replace_me_with_default_list_id

# ElevenLabs Conversational AI Voice Integration
ELEVENLABS_API_KEY=replace_me_with_elevenlabs_api_key
ELEVENLABS_AGENT_ID=replace_me_with_elevenlabs_agent_id
ELEVENLABS_WEBHOOK_SECRET=replace_me_with_elevenlabs_webhook_secret

# Centralized MCP Gateway Host
MCP_GATEWAY_URL=http://localhost:4000
MCP_GATEWAY_AUTH_TOKEN=replace_me_with_internal_mcp_token

# AI / Extraction
GEMINI_API_KEY=replace_me

# Database / Persistence (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/multi_app_agent
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_with_supabase_service_role_key
SUPABASE_ANON_KEY=replace_me_with_supabase_anon_key
